{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dv:schema:v1:validation-report",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "urn:dv:schema:v1:validation-report",
      "description": "Versioned schema URN identifying this payload."
    },
    "ok": {
      "type": "boolean",
      "description": "True iff `problems` is empty. Warnings never affect it."
    },
    "recordsChecked": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "description": "Non-fatal findings. Never affect `ok` or the exit code. Added in a minor revision of v1; absent in reports from older dv releases.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Open enumeration: consumers must tolerate codes they don't recognize."
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "hint": {
            "type": "string",
            "description": "What to do about the warning."
          }
        },
        "required": [
          "code",
          "message",
          "hint"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "recordsChecked",
    "problems"
  ],
  "additionalProperties": false,
  "title": "Validation report",
  "description": "The `dv validate --json` report: ok flag, problems, and non-fatal warnings."
}
